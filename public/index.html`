                    { id: 'filter', group: 'key', label: 'filter()', size: 12, desc: 'Filters items from an iterable.', parent: 'FP', params: ['function', 'iterable'], example: 'list(filter(lambda x: x>0, [-1, 1]))' },
                    { id: 'enumerate', group: 'key', label: 'enumerate()', size: 12, desc: 'Adds a counter to an iterable.', parent: 'FP', params: ['iterable', 'start'], example: 'for i, val in enumerate(["a", "b"]):' },
                    { id: 'zip', group: 'key', label: 'zip()', size: 12, desc: 'Aggregates elements from multiple iterables.', parent: 'FP', params: ['*iterables'], example: 'list(zip([1,2], ["a", "b"])) # [(1,"a"), (2,"b")]' },
                    { id: 'any', group: 'key', label: 'any()', size: 12, desc: 'Returns True if any element of iterable is true.', parent: 'FP', params: ['iterable'], example: 'any([False, True, False]) # True' },
                    { id: 'all', group: 'key', label: 'all()', size: 12, desc: 'Returns True if all elements of iterable are true.', parent: 'FP', params: ['iterable'], example: 'all([True, True, True]) # True' },
                    { id: 'sorted', group: 'key', label: 'sorted()', size: 12, desc: 'Returns a new sorted list from the iterable.', parent: 'FP', params: ['iterable', 'key', 'reverse'], example: 'sorted([3, 1, 2]) # [1, 2, 3]' },
                    { id: 'class', group: 'key', label: 'class', size: 12, desc: 'Defines a new class.', parent: 'OO', params: ['ClassName', 'Bases'], example: 'class User:\\n    def __init__(self, name): self.name = name' },
                    { id: 'self', group: 'key', label: 'self', size: 12, desc: 'Reference to the current instance of the class.', parent: 'OO', params: [], example: 'def greet(self):\\n    print(f"Hello {self.name}")' },
                    { id: 'init', group: 'key', label: '__init__', size: 12, desc: 'Initializer method for class instances.', parent: 'OO', params: ['self', 'args'], example: 'def __init__(self, name): self.name = name' },
                    { id: 'str', group: 'key', label: '__str__', size: 12, desc: 'Returns a user-friendly string representation.', parent: 'Magic', params: ['self'], example: 'def __str__(self): return f"User({self.name})"' },
                    { id: 'repr', group: 'key', label: '__repr__', size: 12, desc: 'Returns an unambiguous string representation for devs.', parent: 'Magic', params: ['self'], example: 'def __repr__(self): return f"User(id={self.id})"' },
                    { id: 'getitem', group: 'key', label: '__getitem__', size: 12, desc: 'Implements index-based access (bracket notation).', parent: 'Magic', params: ['self', 'key'], example: 'def __getitem__(self, key): return self.data[key]' },
                    { id: 'with', group: 'key', label: 'with', size: 12, desc: 'Simplifies exception handling by encapsulating try-finally blocks.', parent: 'Context', params: ['expression', 'as target'], example: 'with open("file.txt") as f:\\n    content = f.read()' },
                ],
                links: []
            }
        };

        let currentLang = 'TypeScript';
        let theme = 'dark';

        const svg = d3.select('#viz')
            .append('svg')
            .attr('width', '100%')
            .attr('height', '100%')
            .attr('viewBox', '0 0 1000 1000')
            .attr('preserveAspectRatio', 'xMidYMid meet');

        // Glow Filter
        const defs = svg.append('defs');
        const filter = defs.append('filter')
            .attr('id', 'glow')
            .attr('x', '-50%')
            .attr('y', '-50%')
            .attr('width', '200%')
            .attr('height', '200%');

        filter.append('feGaussianBlur')
            .attr('stdDeviation', '3')
            .attr('result', 'coloredBlur');

        filter.append('feMerge')
            .append('feMergeNode').attr('in', 'coloredBlur');
        filter.append('feMerge')
            .append('feMergeNode').attr('in', 'SourceGraphic');

        const g = svg.append('g');
        const linkGroup = g.append('g').attr('class', 'links');
        const nodeGroup = g.append('g').attr('class', 'nodes');

        const simulation = d3.forceSimulation()
            .force('link', d3.forceLink().id(d => d.id).distance(100))
            .force('charge', d3.forceManyBody().strength(-400))
            .force('center', d3.forceCenter(500, 500))
            .force('collision', d3.forceCollide().radius(d => d.size + 10));

        function initTabs() {
            const nav = document.getElementById('language-tabs');
            Object.keys(DATA).forEach(lang => {
                const btn = document.createElement('button');
                btn.className = `transition-all duration-200 hover:opacity-100 ${lang === currentLang ? 'tab-active opacity-100' : 'opacity-50'}`;
                btn.textContent = lang;
                btn.onclick = () => switchLanguage(lang);
                btn.dataset.lang = lang;
                nav.appendChild(btn);
            });
        }

        function switchLanguage(lang) {
            currentLang = lang;

            // Update Tabs
            document.querySelectorAll('#language-tabs button').forEach(btn => {
                btn.classList.toggle('tab-active', btn.dataset.lang === lang);
                btn.classList.toggle('opacity-100', btn.dataset.lang === lang);
                btn.classList.toggle('opacity-50', btn.dataset.lang !== lang);
            });

            renderGraph();
        }

        function renderGraph() {
            const langData = DATA[currentLang];
            const nodes = [...langData.nodes];
            const links = [];

            // Root link
            const root = nodes.find(n => n.group === 'root');
            nodes.forEach(n => {
                if (n.group === 'cat') {
                    links.push({ source: root.id, target: n.id });
                } else if (n.group === 'key') {
                    links.push({ source: n.parent, target: n.id });
                }
            });

            linkGroup.selectAll('*').remove();
            nodeGroup.selectAll('*').remove();

            const link = linkGroup.selectAll('line')
                .data(links)
                .enter().append('line')
                .attr('class', 'link')
                .attr('stroke', theme === 'dark' ? 'var(--line-dark)' : 'var(--line-light)')
                .attr('stroke-width', 1);

            const node = nodeGroup.selectAll('g')
                .data(nodes)
                .enter().append('g')
                .attr('class', 'node')
                .on('click', (event, d) => showDetails(d))
                .on('mouseover', (event, d) => {
                    highlightPath(d, links);
                    showTooltip(event, d);
                })
                .on('mousemove', (event) => {
                    updateTooltipPosition(event);
                })
                .on('mouseout', () => {
                    resetHighlight();
                    hideTooltip();
                });

            node.append('circle')
                .attr('r', d => d.size)
                .attr('fill', d => {
                    if (d.group === 'root') return langData.color;
                    if (d.group === 'cat') return theme === 'dark' ? '#1E293B' : '#E2E8F0';
                    return theme === 'dark' ? '#334155' : '#F1F5F9';
                })
                .attr('stroke', d => d.group === 'root' ? 'none' : langData.color)
                .attr('stroke-width', 2)
                .attr('class', d => d.group === 'root' ? 'node-glow' : '');

            node.append('text')
                .text(d => d.label)
                .attr('text-anchor', 'middle')
                .attr('dy', '.35em')
                .attr('fill', d => d.group === 'root' ? '#FFF' : (theme === 'dark' ? '#CBD5E1' : '#475569'))
                .attr('class', 'mono text-[10px] font-medium pointer-events-none')
                .style('font-size', d => d.group === 'root' ? '14px' : '10px')
                .style('font-weight', d => d.group === 'root' ? 'bold' : 'normal');

            simulation.nodes(nodes);
            simulation.force('link').links(links);
            simulation.alpha(1).restart();

            simulation.on('tick', () => {
                link.attr('x1', d => d.source.x)
                    .attr('y1', d => d.source.y)
                    .attr('x2', d => d.target.x)
                    .attr('y2', d.target.y);

                node.attr('transform', d => `translate(${d.x},${d.y})`);
            });
        }

        function showTooltip(event, d) {
            const tooltip = document.getElementById('tooltip');
            let content = `<strong>${d.label}</strong>`;

            if (d.params && d.params.length > 0) {
                content += `<div class="mt-1 text-slate-500">Params: <span class="text-slate-800 dark:text-slate-200">${d.params.join(', ')}</span></div>`;
            } else if (d.group === 'key') {
                content += `<div class="mt-1 text-slate-500">No parameters</div>`;
            }

            tooltip.innerHTML = content;
            tooltip.classList.remove('opacity-0');
            updateTooltipPosition(event);
        }

        function updateTooltipPosition(event) {
            const tooltip = document.getElementById('tooltip');
            tooltip.style.left = (event.clientX + 15) + 'px';
            tooltip.style.top = (event.clientY + 15) + 'px';
        }

        function hideTooltip() {
            document.getElementById('tooltip').classList.add('opacity-0');
        }

        function highlightPath(node, allLinks) {
            const path = new Set();
            let current = node;

            // Trace back to root
            while (current && current.parent) {
                const link = allLinks.find(l =>
                    (l.source.id === current.parent && l.target.id === current.id) ||
                    (l.target.id === current.parent && l.source.id === current.id)
                );
                if (link) path.add(link);
                current = DATA[currentLang].nodes.find(n => n.id === current.parent);
            }

            // Root connect
            const root = DATA[currentLang].nodes.find(n => n.group === 'root');
            const rootLink = allLinks.find(l =>
                (l.source.id === root.id && l.target.id === (node.group === 'cat' ? node.id : node.parent)) ||
                (l.target.id === root.id && l.source.id === (node.group === 'cat' ? node.id : node.parent))
            );
            if (rootLink) path.add(rootLink);

            d3.selectAll('.link').classed('highlighted', l => path.has(l))
                .attr('stroke', l => path.has(l) ? DATA[currentLang].color : (theme === 'dark' ? 'var(--line-dark)' : 'var(--line-light)'));
        }

        function resetHighlight() {
            d3.selectAll('.link').classed('highlighted', false)
                .attr('stroke', theme === 'dark' ? 'var(--line-dark)' : 'var(--line-light)');
        }

        function showDetails(node) {
            const panel = document.getElementById('info-panel');
            const content = document.getElementById('panel-content');

            panel.classList.remove('hidden-panel');

            let paramsHtml = '';
            if (node.params && node.params.length > 0) {
                paramsHtml = `
                    <div class="mt-6">
                        <h3 class="text-sm font-bold mb-3 opacity-50 uppercase tracking-tighter">Parameters / Signature</h3>
                        <div class="flex flex-wrap gap-2">
                            ${node.params.map(p => `<span class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 mono text-xs">${p}</span>`).join('')}
                        </div>
                    </div>
                `;
            }

            let exampleHtml = '';
            if (node.example) {
                exampleHtml = `
                    <div class="mt-6">
                        <h3 class="text-sm font-bold mb-3 opacity-50 uppercase tracking-tighter">Example</h3>
                        <pre class="p-4 rounded-xl bg-slate-900 text-slate-300 mono text-xs overflow-x-auto border border-slate-800 leading-relaxed"><code>${node.example}</code></pre>
                    </div>
                `;
            }

            content.innerHTML = `
                <div class="mb-8">
                    <span class="text-xs uppercase tracking-widest opacity-50 font-bold mb-2 block">${node.group === 'root' ? 'Language' : node.group === 'cat' ? 'Category' : 'Keyword'}</span>
                    <h2 class="text-4xl font-extrabold mb-4 mono">${node.label}</h2>
                    <p class="text-lg opacity-70 leading-relaxed">${node.desc}</p>
                </div>
                ${paramsHtml}
                ${exampleHtml}
                <div class="p-4 rounded-xl bg-slate-100 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 mt-8">
                    <h3 class="text-sm font-bold mb-2 opacity-50 uppercase tracking-tighter">Quick Fact</h3>
                    <p class="text-sm mono italic opacity-80">
                        ${node.group === 'key' ? `Associated with ${node.parent}` : `Core part of ${currentLang}`}
                    </p>
                </div>
            `;
        }

        document.getElementById('close-panel').onclick = () => {
            document.getElementById('info-panel').classList.add('hidden-panel');
        };

        document.getElementById('theme-toggle').onclick = () => {
            theme = theme === 'dark' ? 'light' : 'dark';
            document.body.setAttribute('data-theme', theme);
            document.getElementById('sun-icon').classList.toggle('hidden');
            document.getElementById('moon-icon').classList.toggle('hidden');
            renderGraph();
        };

        initTabs();
        switchLanguage('TypeScript');

        document.getElementById('search-input').oninput = (e) => {
            const term = e.target.value.toLowerCase();
            if (!term) {
                resetSearch();
                return;
            }

            const langData = DATA[currentLang];
            const nodes = langData.nodes;

            d3.selectAll('.node').style('opacity', d => {
                const isMatch = d.label.toLowerCase().includes(term) || d.desc.toLowerCase().includes(term);
                return isMatch ? 1 : 0.2;
            });

            d3.selectAll('.link').style('opacity', d => {
                const source = nodes.find(n => n.id === (d.source.id || d.source));
                const target = nodes.find(n => n.id === (d.target.id || d.target));
                const isMatch = (source && source.label.toLowerCase().includes(term)) ||
                                (target && target.label.toLowerCase().includes(term));
                return isMatch ? 1 : 0.1;
            });
        };

        function resetSearch() {
            d3.selectAll('.node').style('opacity', 1);
            d3.selectAll('.link').style('opacity', 0.4);
        }
    </script>
</body>
</html>
